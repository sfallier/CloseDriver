<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CloseDriver.Core\CloseDriver.Core.csproj" />
    <ProjectReference Include="..\CloseDriver.Bluetooth.Windows\CloseDriver.Bluetooth.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows 11 build 22000 has CET shadow stacks but lacks SpecialUserModeApc;
         disables the CET-compat PE flag so the .NET 9 runtime doesn't fail-fast on startup.
         Remove this once the host OS is updated to 22H2+ (build 22621+). -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>
